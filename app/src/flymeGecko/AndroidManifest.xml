<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback" android:required="false"
        tools:replace="android:required" />
    <!-- No spectrum display on Flyme: drop the microphone permission the shared manifest asks for. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <queries>
        <package android:name="com.ecarx.sdk.openapi" />
        <package android:name="ecarx.xsf.mediacenter" />
    </queries>
    <application android:label="${flymeApplicationLabel}"
        android:networkSecurityConfig="@xml/gecko_auth_network_security"
        tools:replace="android:label">
        <!-- Flyme small window: draw it like a phone screen (720 px at 320 dpi = 360 dp wide) instead of
             a whole 1080-wide screen shrunk to fit, which made every text and button too small. -->
        <meta-data android:name="com.android.app.windowmode.resolution.width" android:value="720" />
        <meta-data android:name="com.android.app.windowmode.dpi" android:value="320" />
        <activity android:name=".MainActivity"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- The small window: the whole app in its own task (see WindowHosts). -->
        <activity android:name=".MiniWindowActivity"
            android:exported="false"
            android:taskAffinity="${applicationId}.mini"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".integration.GeckoMusicKitAuthActivity"
            android:exported="false" android:process=":gecko_auth"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.AmAtv" />
        <activity android:name=".integration.GeckoRadioProbeActivity"
            android:enabled="${flymeRadioProbeEnabled}"
            android:exported="true" android:permission="android.permission.DUMP"
            android:process=":gecko_auth"
            android:theme="@style/Theme.AmAtv" />
    </application>
</manifest>
