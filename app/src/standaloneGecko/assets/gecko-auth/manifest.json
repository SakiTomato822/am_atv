{
  "manifest_version": 2,
  "name": "AM for TV authentication bridge",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": { "id": "amatv-auth@dev.amatv" }
  },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "https://*.apple.com/*",
        "https://*.apple.com.cn/*",
        "https://*.icloud.com/*",
        "https://*.icloud.com.cn/*",
        "https://*.cdn-apple.com/*"
      ],
      "js": ["signin-ui.js", "bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
